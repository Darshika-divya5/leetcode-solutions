url': '/submissions/detail/1995734666/', 'is_pending': 'Not Pending', 'title': "Pascal's Triangle", 'memory': '43.4 MB', 'code': 'import java.util.*;\n\nclass Solution {\n    public List<List<Integer>> generate(int numRows) {\n        List<List<Integer>> result = new ArrayList<>();\n\n        for (int i = 0; i < numRows; i++) {\n            List<Integer> row = new ArrayList<>();\n\n            for (int j = 0; j <= i; j++) {\n                // First and last elements are always 1\n                if (j == 0 || j == i) {\n                    row.add(1);\n                } else {\n                    row.add(result.get(i - 1).get(j - 1) +\n                            result.get(i - 1).get(j));\n                }\n            }\n\n            result.add(row);\n        }\n\n        return result;\n    }\n}', 'compare_result': '111111111111111111111111111111', 'title_slug': 'pascals-triangle', 'has_notes': False, 'flag_type': 1, 'frontend_id': 84}, {'id': 1995734266, 'question_id': 108, 'lang': 'java', 'lang_name': 'Java', 'time': '6\xa0days, 8\xa0hours', 'timestamp': 1777977960, 'status': 10, 'status_display': 'Accepted', 'runtime': '0 ms', 'url': '/submissions/detail/1995734266/', 'is_pending': 'Not Pending', 'title': 'Convert Sorted Array to Binary Search Tree', 'memory': '44.8 MB', 'code': '/**\n * Definition for a binary tree node.\n * public class TreeNode {\n *     int val;\n *     TreeNode left;\n *     TreeNode right;\n *     TreeNode() {}\n *     TreeNode(int val) { this.val = val; }\n *     TreeNode(int val, TreeNode left, TreeNode right) {\n *         this.val = val;\n *         this.left = left;\n *         this.right = right;\n *     }\n * }\n */\nclass Solution {\n    public TreeNode sortedArrayToBST(int[] nums) {\n        return build(nums, 0, nums.length - 1);\n    }\n\n    private TreeNode build(int[] nums, int left, int right) {\n        if (left > right) return null;\n\n        int mid = left + (right - left) / 2;\n\n        TreeNode root = new TreeNode(nums[mid]);\n        root.left = build(nums, left, mid - 1);\n        root.right = build(nums, mid + 1, right);\n\n        return root;\n    }\n}', 'compare_result': '1111111111111111111111111111111', 'title_slug': 'convert-sorted-array-to-binary-search-tree', 'has_notes': False, 'flag_type': 1, 'frontend_id': 83}, {'id': 1995733459, 'question_id': 88, 'lang': 'java', 'lang_name': 'Java', 'time': '6\xa0days, 8\xa0hours', 'timestamp': 1777977877, 'status': 10, 'status_display': 'Accepted', 'runtime': '0 ms', 'url': '/submissions/detail/1995733459/', 'is_pending': 'Not Pending', 'title': 'Merge Sorted Array', 'memory': '43.6 MB', 'code': 'class Solution {\n    public void merge(int[] nums1, int m, int[] nums2, int n) {\n        int i = m - 1;      // pointer for nums1\n        int j = n - 1;      // pointer for nums2\n        int k = m + n - 1;  // pointer for final position\n\n        while (j >= 0) {\n            if (i >= 0 && nums1[i] > nums2[j]) {\n                nums1[k] = nums1[i];\n                i--;\n            } else {\n                nums1[k] = nums2[j];\n                j--;\n            }\n            k--;\n        }\n    }\n}', 'compare_result': '11111111111111111111111111111111111111111111111111111111111', 'title_slug': 'merge-sorted-array', 'has_notes': False, 'flag_type': 1, 'frontend_id': 82}, {'id': 1995732797, 'question_id': 14, 'lang': 'java', 'lang_name': 'Java', 'time': '6\xa0days, 8\xa0hours', 'timestamp': 1777977813, 'status': 10, 'status_display': 'Accepted', 'runtime': '0 ms', 'url': '/submissions/detail/1995732797/', 'is_pending': 'Not Pending', 'title': 'Longest Common Prefix', 'memory': '43 MB', 'code': 'class Solution {\n    public String longestCommonPrefix(String[] strs) {\n        if (strs == null || strs.length == 0) return "";\n\n        String prefix = strs[0];\n\n        for (int i = 1; i < strs.length; i++) {\n            while (strs[i].indexOf(prefix) != 0) {\n                prefix = prefix.substring(0, prefix.length() -